[Unit]
Description=Tech Radar API (Hono)
Documentation=file:///home/shogo/apps/trendnews-autoReporting/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shogo
Group=shogo
WorkingDirectory=/home/shogo/apps/trendnews-autoReporting
# 秘密値は WorkingDirectory 直下の dotenv ファイルを src/lib/env.ts が読む。
# EnvironmentFile= へ写すと開発時と systemd 実行時で内容がずれるため置かない。
ExecStart=/home/shogo/.nvm/versions/node/v22.23.2/bin/node dist/api/server.js
Restart=on-failure
RestartSec=5

# 最小権限。ProtectSystem=strict は /home も read-only にするので、
# 書き込む先だけを ReadWritePaths で開ける。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/home/shogo/apps/trendnews-autoReporting/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tech-radar-api

[Install]
WantedBy=multi-user.target
