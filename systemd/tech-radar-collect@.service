[Unit]
Description=Tech Radar collector (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shogo
Group=shogo
WorkingDirectory=/home/shogo/apps/trendnews-autoReporting
# 秘密値は WorkingDirectory 直下の dotenv ファイルを src/lib/env.ts が読む。
ExecStart=/home/shogo/.nvm/versions/node/v22.23.2/bin/node dist/jobs/collect.js %i

# 1ソースの失敗では非ゼロ終了しない（全ソース失敗時のみ exit 1）。
# Type=oneshot では Restart= を使えないため、失敗時は次回のタイマー起動で再試行する。
TimeoutStartSec=600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/home/shogo/apps/trendnews-autoReporting/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tech-radar-collect-%i
