[Unit]
Description=Tech Radar Connpass notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shogo
Group=shogo
WorkingDirectory=/home/shogo/apps/trendnews-autoReporting
# 秘密値は WorkingDirectory 直下の dotenv ファイルを src/lib/env.ts が読む。
ExecStart=/home/shogo/.nvm/versions/node/v22.23.2/bin/node dist/jobs/connpass.js
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/home/shogo/apps/trendnews-autoReporting/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tech-radar-connpass
